;; Windows
(defwindow topbar
  :monitor 0
  :geometry (geometry 
    :x "0%"
    :y "0px" 
    :width "100%" 
    :height "32px"
    :anchor "top center")
  :stacking "fg"
  :reserve (struts :distance "32px" :side "top")
  :windowtype "dock"
  :wm-ignore false
  :exclusive true
  
  (box
    :orientation "h"
    :halign "fill"
    :class "bar-container"
    
    ;; Левая секция - Рабочие пространства
    (box
      :orientation "h"
      :halign "start"
      :valign "center"
      :class "left-section"
      :spacing 4
      (workspace :id "1")
      (workspace :id "2")
      (workspace :id "3")
      (workspace :id "4")
      (workspace :id "5")
    )
    
    ;; Центральная секция - Системная информация
    (box
      :orientation "h"
      :halign "center"
      :valign "center"
      :class "center-section"
      (sysinfo)
    )
    
    ;; Правая секция - Время и контролы
    (box
      :orientation "h"
      :halign "end"
      :valign "center"
      :class "right-section"
      :spacing 8
      (swaync-widget)
      ;; Systray widget - If icons are not showing, or only labels appear in the context menu,
      ;; please ensure your Eww version is up-to-date, and you have 'libappindicator-gtk3' installed.
      ;; Also, verify your GTK icon theme. Eww works on GTK3 only.
      (systray)
      (mic-widget)
      (volume-widget)
      (time-widget)
      
      ;; Кнопка выключения
      (button
        :onclick "${EWW_CMD} open powermenu"
        :class "power-btn"
        (label :text "⏻")
      )
    )
  )
)

(defwindow calendar-win
  :monitor 0
  :geometry (geometry :x "-10px" :y "40px" :anchor "top right")
  :stacking "fg"
  :windowtype "dock"
  :wm-ignore false
  (calendar :class "cal" :day {formattime(EWW_TIME, "%d")} :month {formattime(EWW_TIME, "%m")} :year {formattime(EWW_TIME, "%Y")}))

(defwindow powermenu
  :geometry (geometry 
    :x "90%" 
    :y "40px" 
    :width "180px" 
    :height "180px"
    :anchor "top right")
  :stacking "fg"
  :windowtype "dialog"
  :monitor 0
  
  (box
    :orientation "v"
    :spacing "12"
    :class "power-menu"
    
    (button
      :onclick "systemctl suspend && ${EWW_CMD} close powermenu"
      :class "menu-item suspend"
      (box :orientation "h" :spacing 10 (label :text "󰒲") (label :text "Suspend")))
    
    (button
      :onclick "systemctl reboot && ${EWW_CMD} close powermenu"
      :class "menu-item reboot"
      (box :orientation "h" :spacing 10 (label :text "󰜙") (label :text "Reboot")))
    
    (button
      :onclick "systemctl poweroff && ${EWW_CMD} close powermenu"
      :class "menu-item shutdown"
      (box :orientation "h" :spacing 10 (label :text "󰐥") (label :text "Shutdown")))
    
    (button
      :onclick "${EWW_CMD} close powermenu"
      :class "menu-item cancel"
      (box :orientation "h" :spacing 10 (label :text "  ") (label :text "Cancel")))
  )
)

(defwindow volume-slider-win
  :monitor 0
  :geometry (geometry :x "-20px" :y "80px" :anchor "top right")
  :stacking "fg"
  :windowtype "dock"
  :wm-ignore false
  (volume-slider)
)

(defwindow mic-slider-win
  :monitor 0
  :geometry (geometry :x "-20px" :y "140px" :anchor "top right")
  :stacking "fg"
  :windowtype "dock"
  :wm-ignore false
  (mic-slider)
)
